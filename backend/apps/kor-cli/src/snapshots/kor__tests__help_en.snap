      --lang <LANG>
          Interface language (tr, en, fr)

      --days <DAYS>
          Number of days
          
          [default: 28]

      --privacy-mode
          Privacy mode: local models only, no outbound calls from Kor

      --dims <DIMS>
          Dimensions, comma-separated (query, page, country, device, date)
          
          [default: query]

      --remote <REMOTE>
          Run the agent on this server over SSH: user@host[:port] or a connections.toml id

      --top <TOP>
          How many rows to show
          
          [default: 30]

      --cached
          Use the locally cached Search Console rows

      --explain
          Show the calculation for every row

      --json
          Print JSON

  -h, --help
          Print help
