{
  "$id": "kor/task-plan.v1",
  "title": "Multi-agent task plan (kor task, spec 8.2)",
  "type": "object",
  "properties": {
    "summary": { "type": "string", "maxLength": 2000 },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "minLength": 1, "maxLength": 40 },
          "goal": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "files": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "required": ["role", "goal", "files"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "subtasks"],
  "additionalProperties": false
}
