<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 OR MIT -->
<!-- MSI additions (spec §24.4, ADR 0064): the machine-wide install puts its folder (with the bundled
     kor.exe) on the system PATH, removed again on uninstall, and runs `kor install-hooks` for the
     Chrome native messaging host (HKLM). Referenced from tauri.release.conf.json (componentRefs). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="KorCliPath" Guid="5E0B7C2A-6F1D-4B8E-9C3A-2D4F6A8B1C30">
        <Environment Id="KorCliPathEntry" Name="PATH" Value="[INSTALLDIR]" Part="last" Action="set" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\[Manufacturer]\[ProductName]" Name="CliOnPath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <CustomAction Id="KorPostInstall" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]kor.exe&quot; install-hooks post-install --system" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="KorPreUninstall" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]kor.exe&quot; install-hooks pre-uninstall --system" Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- §25.4: the uninstalling user's context-menu entries (HKCU), so it runs as that user. -->
    <CustomAction Id="KorPreUninstallUser" Directory="INSTALLDIR" ExeCommand="&quot;[INSTALLDIR]kor.exe&quot; install-hooks pre-uninstall" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="KorPostInstall" Before="InstallFinalize">NOT REMOVE</Custom>
      <Custom Action="KorPreUninstallUser" Before="KorPreUninstall">REMOVE~="ALL"</Custom>
      <Custom Action="KorPreUninstall" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
